<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- More ways up (idea "more ways up" on docs/mod-comparison/ideas.html; decision D3 answered 2026-11-06, ladders and stair sizes).
	     Each kind has an up piece on the lower floor and a down piece on the floor above. The large kinds are one building with a 2 by 2 footprint,
	     and their partner covers the same four cells above. The kinds are listed in WayUpKinds.cs. Costs and strength are decision DM15. -->

	<ThingDef ParentName="StairsBase">
		<defName>ZL_SmallLadderUp</defName>
		<placeWorkers>
			<li>ZLevels.PlaceWorker_Stairs</li>
		</placeWorkers>
		<label>small ladder up</label>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<description>A small ladder up to the floor above. It takes one cell and is cheap to build.</description>
		<thingClass>ZLevels.Building_StairsUp</thingClass>
		<graphicData>
			<texPath>Building/LadderUp</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3, 3)</drawSize>
		</graphicData>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToBuild>400</WorkToBuild>
			<Mass>2</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>1</Beauty>
		</statBases>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
		</stuffCategories>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
		<costStuffCount>5</costStuffCount>
		<rotatable>true</rotatable>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
		<pathCost>30</pathCost>
		<designationCategory>Structure</designationCategory>
	</ThingDef>

