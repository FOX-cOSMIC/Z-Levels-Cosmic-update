<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Pipes between floors (idea "pipes between floors" on docs/mod-comparison/ideas.html; decision D4, answered 2026-11-06: one chosen resource per
	     pipe, at a fixed rate). One pipe is built on the lower floor, and its other end stands on the floor above, on the same cell. The rate is set by
	     the extension below (decision DM18). The resource is chosen in game (decision DM19). -->

	<ThingDef ParentName="BuildingBase">
		<defName>ZL_FloorPipe</defName>
		<label>floor pipe</label>
		<description>A pipe between two floors. It moves one chosen resource from storage on its sending floor to the floor above or below, at a fixed rate. Its other end stands on the same cell on the other floor.</description>
		<designationCategory>Structure</designationCategory>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.1</fillPercent>
		<placeWorkers>
			<li>ZLevels.PlaceWorker_FloorPipe</li>
		</placeWorkers>
		<thingClass>ZLevels.Building_FloorPipe</thingClass>
		<tickerType>Rare</tickerType>
		<pathCost>30</pathCost>
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<WorkToBuild>300</WorkToBuild>
			<Mass>3</Mass>
			<Flammability>0.0</Flammability>
			<Beauty>0</Beauty>
		</statBases>
		<costList>
			<Steel>10</Steel>
		</costList>
		<rotatable>false</rotatable>
		<canOverlapZones>false</canOverlapZones>
		<graphicData>
			<drawSize>(1,1)</drawSize>
			<texPath>Things/Building/Furniture/Column</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<building>
			<isInert>true</isInert>
		</building>
		<modExtensions>
			<li Class="ZLevels.FloorPipeExtension">
				<itemsPerDay>60</itemsPerDay>
			</li>
		</modExtensions>
	</ThingDef>

</Defs>
