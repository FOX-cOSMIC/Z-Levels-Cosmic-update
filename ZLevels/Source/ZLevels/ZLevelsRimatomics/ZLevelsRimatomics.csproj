<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZLevelsRimatomics</RootNamespace>
    <AssemblyName>ZLevelsRimatomics</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableSourceLink>false</EnableSourceLink>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputPath>../../../1.7/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <HarmonyAssembly Condition="'$(HarmonyAssembly)' == ''">$(RimWorldDirectory)/../../workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyAssembly>
    <RimatomicsAssembly Condition="'$(RimatomicsAssembly)' == ''">$(RimWorldDirectory)/../../workshop/content/294100/1127530465/1.7/Assemblies/Rimatomics.dll</RimatomicsAssembly>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('RimWorld.targets', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <ProjectReference Include="../ZLevels/ZLevels.csproj" Private="false" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2" PrivateAssets="all" />
    <Reference Include="0Harmony" HintPath="$(HarmonyAssembly)" Private="false" />
    <Reference Include="Rimatomics" HintPath="$(RimatomicsAssembly)" Private="false" />
  </ItemGroup>
  <Target Name="CheckExternalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(HarmonyAssembly)')" Text="Set HarmonyAssembly to the installed RimWorld 1.7 Harmony DLL." />
    <Error Condition="!Exists('$(RimatomicsAssembly)')" Text="Set RimatomicsAssembly to the installed Dubs Rimatomics 1.7 DLL." />
  </Target>
</Project>
