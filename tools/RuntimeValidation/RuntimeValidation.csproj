<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('RimWorld.targets', '$(MSBuildThisFileDirectory)'))" />
  <ItemGroup>
    <ProjectReference Include="../../ZLevels/Source/ZLevels/ZLevels/ZLevels.csproj" Private="false" />
    <ProjectReference Include="../../ZLevels/Source/ZLevels/ZLevelsRimatomics/ZLevelsRimatomics.csproj" Private="false" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldPackageVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>
