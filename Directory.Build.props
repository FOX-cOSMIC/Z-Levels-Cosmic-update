<Project>
  <PropertyGroup>
    <RimWorldVersion>1.7.5011 rev24</RimWorldVersion>
    <!-- NuGet has no Krafs.Rimworld.Ref for 1.7.5011 yet. The mod compiles against the 1.7.5005 reference. Every game member the built DLLs
         reference, public or publicized, exists unchanged in 1.7.5011 (ADR 0012). When the 1.7.5011 package exists, set this back to
         $(RimWorldVersion.Split(' ')[0])-unstable; tools/Check-Docs.ps1 prints a note while the pin stands. -->
    <RimWorldPackageVersion>1.7.5005-unstable</RimWorldPackageVersion>
    <RimWorldDirectory Condition="'$(RimWorldDirectory)' == ''">C:/SteamLibrary/steamapps/common/RimWorld</RimWorldDirectory>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
